# Default 90s — less CPU than 60s. Raise to 120000 locally if needed.
INGEST_INTERVAL_MS=90000
ENABLE_INGEST=true
# Set false to skip HTML og:image fetches (biggest CPU saver after interval)
ENABLE_OG_ENRICH=true
ENABLE_SOCIAL_SCRAPERS=false
NEXT_PUBLIC_ENABLE_SOCIAL=false
# REDIS_URL=redis://127.0.0.1:6379
# DATABASE_URL=postgres://bodash:bodash@127.0.0.1:5432/bodash
# Optional NASA FIRMS key (INPE Queimadas already covers Bolivia fire hotspots)
# FIRMS_MAP_KEY=
